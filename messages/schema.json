{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Sever agent mailbox v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["protocol_version", "from", "to", "branch", "last_sequence", "ack_sequence", "messages"],
    "properties": {
        "protocol_version": {"const": 1},
        "from": {"enum": ["agent1", "agent2"]},
        "to": {"enum": ["agent1", "agent2"]},
        "branch": {"enum": ["agent1", "agent2"]},
        "last_sequence": {"type": "integer", "minimum": 0},
        "ack_sequence": {"type": "integer", "minimum": 0},
        "messages": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "sequence", "sent_at", "kind", "task", "in_reply_to", "summary", "body", "commits", "paths", "checks", "needs_reply"],
                "properties": {
                    "id": {"type": "string", "pattern": "^agent[12]-[0-9]{4,}$"},
                    "sequence": {"type": "integer", "minimum": 1},
                    "sent_at": {"type": "string", "format": "date-time", "pattern": "T.*Z$"},
                    "kind": {"enum": ["request", "accept", "proposal", "progress", "blocked", "handoff", "review", "done"]},
                    "task": {"type": "string", "minLength": 1},
                    "in_reply_to": {"type": ["string", "null"], "pattern": "^agent[12]-[0-9]{4,}$"},
                    "summary": {"type": "string", "minLength": 1},
                    "body": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "commits": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
                    "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
                    "checks": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["command", "result", "detail"],
                            "properties": {
                                "command": {"type": "string", "minLength": 1},
                                "result": {"enum": ["pass", "fail", "skip"]},
                                "detail": {"type": "string", "minLength": 1}
                            }
                        }
                    },
                    "needs_reply": {"type": "boolean"}
                }
            }
        }
    }
}
