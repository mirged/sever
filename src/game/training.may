import "../core/types.may";
import "../core/math.may";
import "../physics/step.may";
import "../physics/rigid.may";
import "../physics/transforms.may";
import "cutter.may";

pub struct Player {
    position: Vec2,
    velocity: Vec2,
    grounded: Bool,
    finished: Bool,
    deaths: Int
}

pub struct Controls {
    horizontal: Int,
    jump: Bool
}

pub struct Training {
    world: World,
    player: Player,
    player_shape: Polygon,
    cutter: Cutter,
    aim: Vec2
}

fun platform(id: Int, x: Float, top: Float, width: Float, height: Float) -> Body {
    return Body(id, rectangle(width, height), Vec2(x, top - height * 0.5),
        Vec2(0.0, 0.0), 0.0, 0.0, false, true, "concrete");
}

pub fun create_training() -> Training {
    let bodies: List<Body> = [
        platform(10, -5.0, 0.0, 10.0, 1.0),
        platform(11, 11.0, 0.0, 10.0, 1.0),
        platform(12, -2.0, 1.2, 3.6, 0.4),
        platform(13, 2.0, 2.4, 3.0, 0.4),
        platform(14, 6.0, 3.6, 3.0, 0.4),
        platform(15, 10.5, 3.6, 4.0, 0.4),
        platform(16, 1.0, 6.2, 5.0, 0.35)
    ];
    let cables: List<Cable> = [
        Cable(10, Vec2(-1.0, 8.0), Vec2(-1.0, 6.2), 16, true),
        Cable(11, Vec2(3.0, 8.0), Vec2(3.0, 6.2), 16, true)
    ];
    bodies[0].cuttable = false;
    bodies[0].material = "bedrock";
    bodies[1].cuttable = false;
    bodies[1].material = "bedrock";
    bodies[6].material = "steel";
    return Training(World(bodies, cables, Vec2(0.0, -24.0), 0),
        Player(Vec2(-6.0, 0.65), Vec2(0.0, 0.0), true, false, 0),
        rectangle(0.6, 1.3), create_cutter(), Vec2(1.0, 0.0));
}

/// One fixed tick, with four contact substeps and no variable timestep input.
pub fun step_training(training: Training, input: Controls) -> Nil {
    let player: Player = training.player;
    training.world.tick += 1;
    tick_cutter(training.cutter);
    if (player.finished) {
        return;
    }
    player.velocity.x = float(max(-1, min(1, input.horizontal))) * 5.5;
    if (input.jump and player.grounded) {
        player.velocity.y = 9.5;
        player.grounded = false;
    }
    let dt: Float = fixed_dt() * 0.25;
    let character: Body = Body(-1, training.player_shape, player.position,
        player.velocity, 0.0, 0.0, false, false, "character");
    for substep: Int in 0..4 {
        let proxies: List<RigidProxy> = step_rigid_world(training.world, dt);
        player.velocity.y = float(max(-20.0, player.velocity.y + training.world.gravity.y * dt));
        player.position.x += player.velocity.x * dt;
        player.position.y += player.velocity.y * dt;
        player.grounded = resolve_character(character, proxies);
    }
    retire_debris(training.world);
    if (player.position.y < -5.0 or player.position.x < -11.0 or player.position.x > 17.0) {
        player.position = Vec2(-6.0, 0.65);
        player.velocity = Vec2(0.0, 0.0);
        player.grounded = true;
        player.deaths += 1;
    }
    if (player.position.x > 10.8 and player.position.x < 12.3
            and player.position.y > 3.8 and player.position.y < 5.8) {
        player.finished = true;
        player.velocity = Vec2(0.0, 0.0);
    }
    return;
}

pub fun aim_training(training: Training, target: Vec2) -> Nil {
    if (not (bounded_number(target.x, 1000.0) and bounded_number(target.y, 1000.0))) { return; }
    let direction: Vec2 = subtract(target, training.player.position);
    let length: Float = float(sqrt(dot(direction, direction)));
    if (length > 0.001) { training.aim = scale(direction, 1.0 / length); }
    return;
}

pub fun cut_training(training: Training) -> Nil {
    if (not training.player.finished) {
        fire_cutter(training.world, training.cutter, training.player.position,
            add(training.player.position, scale(training.aim, 3.5)));
    }
    return;
}

pub fun demo_cut(training: Training) -> Nil {
    if (training.cutter.cuts == 0 and training.player.position.x > 0.5
            and training.player.position.x < 2.5 and training.player.position.y > 2.5) {
        training.aim = Vec2(0.0, 1.0);
        cut_training(training);
    }
    return;
}

/// A repeatable traversal used by headless previews and end-to-end checks.
pub fun demo_controls(training: Training) -> Controls {
    return Controls(1, training.player.grounded and training.player.position.x < 7.8);
}
