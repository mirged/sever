import "../core/types.may";

pub struct Camera {
    x: Int,
    y: Int,
    width: Int,
    height: Int,
    center: Vec2,
    pixels_per_unit: Float
}

pub fun room_camera(width: Int, height: Int) -> Camera {
    let available_width: Int = int(max(100, width - 296));
    let available_height: Int = int(max(100, height - 278));
    return Camera(264, 174, available_width, available_height, Vec2(2.0, 2.8),
        float(min(float(available_width) / 24.0, float(available_height) / 12.0)));
}

pub fun to_screen(camera: Camera, point: Vec2) -> Vec2 {
    return Vec2(float(camera.x) + float(camera.width) * 0.5
            + (point.x - camera.center.x) * camera.pixels_per_unit,
        float(camera.y) + float(camera.height) * 0.5
            - (point.y - camera.center.y) * camera.pixels_per_unit);
}

pub fun to_world(camera: Camera, point: Vec2) -> Vec2 {
    return Vec2((point.x - float(camera.x) - float(camera.width) * 0.5)
            / camera.pixels_per_unit + camera.center.x,
        -(point.y - float(camera.y) - float(camera.height) * 0.5)
            / camera.pixels_per_unit + camera.center.y);
}

pub fun project_body(camera: Camera, body: Body) -> List<Vec2> {
    let vertices: List<Vec2> = [];
    let cosine: Float = float(cos(body.angle));
    let sine: Float = float(sin(body.angle));
    for vertex: Vec2 in body.shape.vertices {
        push(vertices, to_screen(camera, Vec2(
            vertex.x * cosine - vertex.y * sine + body.position.x,
            vertex.x * sine + vertex.y * cosine + body.position.y)));
    }
    return vertices;
}
