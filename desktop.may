import "ui" as ui;
import "src/core/types.may";
import "src/game/training.may";
import "src/game/timing.may";
import "src/game/magic.may" as casting;
import "src/render/canvas.may" as canvas;
import "src/render/projection.may" as projection;
import "src/render/pacing.may" as pacing;

fun run_workshop() -> Nil {
    let argv: List<Str> = args();
    mut headless: Bool = false;
    mut demo: Bool = false;
    mut cut_demo: Bool = false;
    mut spell_demo: Bool = false;
    mut limit: Int = 0;
    mut snapshot: Str = "";
    mut report: Str = "";
    mut index: Int = 1;
    while (index < len(argv)) {
        let option: Str = argv[index];
        if (option == "--help") {
            print("sever / cutting lab\nA/D or arrows: move. Space/W/Up: jump. Mouse: aim. J: sever. 1-5: select spell. F: cast. P: pause. R: reset. Esc: close.\nOptions: --headless --demo --cut-demo --spell-demo --ticks 1..100000 --snapshot PATH --report PATH\nCut platforms or cables. Dark foundation blocks are protected. Reset restores the room.");
            return;
        } else if (option == "--headless") { headless = true; }
        else if (option == "--demo") { demo = true; }
        else if (option == "--cut-demo") { demo = true; cut_demo = true; }
        else if (option == "--spell-demo") { demo = true; spell_demo = true; }
        else if ((option == "--ticks" or option == "--snapshot" or option == "--report")
                and index + 1 < len(argv)) {
            index += 1;
            if (option == "--ticks") {
                limit = int(argv[index]);
                if (limit < 1 or limit > 100000) { fail("Tick limit must be 1..100000"); }
            }
            else if (option == "--snapshot") { snapshot = argv[index]; }
            else { report = argv[index]; }
        } else { fail("Unknown or incomplete option: " + option); }
        index += 1;
    }
    if (limit < 0 or limit > 100000) { fail("Tick limit must be 1..100000"); }
    if (headless and limit == 0) { limit = 600; }
    print("Opening workshop surface...");
    let window: ui.Window = ui.open("sever / the workshop", 1280, 800, headless);
    print("Renderer:", ui.renderer(window));
    let started: Float = float(clock());
    mut rendered_frames: Int = 0;
    mut event_polls: Int = 0;
    mut stop_reason: Str = "window_closed";
    mut training: Training = create_training();
    mut grimoire: casting.MagicState = casting.create_magic(training);
    mut timer: StepClock = create_clock();
    mut paused: Bool = false;
    may {
        if (headless) {
            for tick: Int in 0..limit {
                if (cut_demo) { demo_cut(training); }
                if (spell_demo) { casting.demo_magic(training, grimoire); }
                step_training(training, if (demo) { demo_controls(training) } else { Controls(0, false) });
                casting.tick_magic(grimoire);
            }
            canvas.draw_scene(window, training, grimoire, false);
            rendered_frames = 1;
            stop_reason = "tick_limit";
        } else {
            mut previous: Float = float(clock());
            mut jump_queued: Bool = false;
            mut running: Bool = true;
            mut next_report: Int = 60;
            let pacer: pacing.FramePacer = pacing.create_pacer();
            while (running) {
                let event: ui.Event = ui.poll_for(window,
                    pacing.frame_wait_ms(pacer, float(clock())));
                event_polls += 1;
                if (event.kind == "close") { break; }
                if (ui.key_pressed(window, 256)) { stop_reason = "escape"; break; }
                let focused: Bool = demo or ui.focused(window);
                let reset: Bool = ui.key_pressed(window, 82);
                let toggle_pause: Bool = ui.key_pressed(window, 80);
                let space: Bool = ui.key_pressed(window, 32);
                let up: Bool = ui.key_pressed(window, 265);
                let w: Bool = ui.key_pressed(window, 87);
                let sever: Bool = ui.key_pressed(window, 74);
                let cast: Bool = ui.key_pressed(window, 70);
                for slot: Int in 0..5 {
                    let pressed: Bool = ui.key_pressed(window, 49 + slot);
                    if (focused and pressed) { casting.select_spell(grimoire, slot); }
                }
                if (focused and reset) {
                    training = create_training();
                    grimoire = casting.create_magic(training);
                    timer = create_clock();
                    paused = false;
                    jump_queued = false;
                }
                if (focused and toggle_pause) { paused = not paused; }
                if (focused and (space or up or w)) { jump_queued = true; }
                let camera: projection.Camera = projection.room_camera(window.width, window.height);
                if (focused and window.mouse_x >= camera.x and window.mouse_x < camera.x + camera.width
                        and window.mouse_y >= camera.y and window.mouse_y < camera.y + camera.height) {
                    casting.aim_magic(training, grimoire, projection.to_world(camera,
                        Vec2(float(window.mouse_x), float(window.mouse_y))));
                }
                if (focused and not paused and sever) { cut_training(training); }
                if (focused and not paused and cast) { casting.cast_selected(training, grimoire); }
                let now: Float = float(clock());
                let ticks: Int = advance_clock(timer, now - previous, paused or not focused);
                previous = now;
                if (paused or not focused) { jump_queued = false; }
                mut direction: Int = 0;
                if (ui.key_down(window, 65) or ui.key_down(window, 263)) { direction -= 1; }
                if (ui.key_down(window, 68) or ui.key_down(window, 262)) { direction += 1; }
                for tick: Int in 0..ticks {
                    if (limit > 0 and training.world.tick >= limit) { break; }
                    if (cut_demo) { demo_cut(training); }
                    if (spell_demo) { casting.demo_magic(training, grimoire); }
                    step_training(training, if (demo) { demo_controls(training) }
                        else { Controls(direction, jump_queued) });
                    casting.tick_magic(grimoire);
                    jump_queued = false;
                }
                let draw_due: Bool = pacing.frame_due(pacer, float(clock()));
                if (draw_due or (limit > 0 and training.world.tick >= limit)) {
                    canvas.draw_scene(window, training, grimoire, paused or not focused);
                    rendered_frames += 1;
                }
                if (limit > 0 and training.world.tick >= next_report) {
                    print("Workshop tick:", training.world.tick);
                    next_report += 60;
                }
                if (limit > 0 and training.world.tick >= limit) {
                    stop_reason = "tick_limit";
                    running = false;
                }
            }
        }
        if (snapshot != "") { ui.snapshot(window, snapshot); }
        if (report != "") {
            mut dynamic_bodies: Int = 0;
            for body: Body in training.world.bodies {
                if (body.dynamic) { dynamic_bodies += 1; }
            }
            write_file(report, json_stringify({"ticks": training.world.tick,
                "requested_ticks": limit, "stop_reason": stop_reason,
                "finished": training.player.finished, "deaths": training.player.deaths,
                "x": training.player.position.x, "y": training.player.position.y,
                "renderer": ui.renderer(window), "dropped_seconds": timer.dropped_seconds,
                "frames": rendered_frames, "event_polls": event_polls,
                "render_limit_hz": if (headless) { 0 } else { 60 },
                "wall_seconds": float(clock()) - started,
                "cuts": training.cutter.cuts, "cables_cut": training.cutter.cables,
                "cut_status": training.cutter.status, "bodies": len(training.world.bodies),
                "dynamic_bodies": dynamic_bodies, "spell_casts": grimoire.book.casts,
                "mana": grimoire.book.mana, "spell_status": grimoire.status,
                "last_spell": grimoire.book.last_spell}) + "\n");
        }
        ui.close(window);
    } otherwise {
        ui.close(window);
        fail(err.message);
    }
    return;
}

may { run_workshop(); } otherwise { print(err.message); exit(1); }
