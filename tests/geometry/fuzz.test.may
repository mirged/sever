import "../../src/core/types.may";
import "../../src/core/math.may";
import "../../src/geometry/slice.may";

/// Deterministic fuzzing: random convex outlines and random finite blades.
let EPSILON: Float = 0.000001;
let TAU: Float = 6.283185307179586;
mut seed: Int = 20261018;

fun expect(value: Bool, label: Str) -> Nil {
    if (not value) {
        fail("FAIL: " + label + " (seed " + str(seed) + ")");
    }
    return;
}

/// Park-Miller minimal standard generator; uniform in [0, 1).
fun random() -> Float {
    seed = (seed * 48271) % 2147483647;
    return float(seed) / 2147483647.0;
}

/// Points on an ellipse at increasing angles are convex in that order.
fun random_convex(cx: Float, cy: Float) -> Polygon {
    let count: Int = 3 + int(random() * 10.0);
    let steps: List<Float> = [];
    mut total: Float = 0.0;
    for i: Int in 0..count {
        let step: Float = 0.2 + random();
        push(steps, step);
        total += step;
    }
    let rx: Float = 0.5 + random() * 5.0;
    let ry: Float = 0.5 + random() * 5.0;
    let turn: Float = random() * TAU;
    let points: List<Vec2> = [];
    mut angle: Float = turn;
    for step: Float in steps {
        angle += TAU * step / total;
        push(points, Vec2(cx + rx * cos(angle), cy + ry * sin(angle)));
    }
    if (random() < 0.5) {
        let reversed: List<Vec2> = [];
        mut i: Int = count - 1;
        while (i >= 0) {
            push(reversed, points[i]);
            i -= 1;
        }
        return Polygon(reversed);
    }
    return Polygon(points);
}

/// Whether `point` lies inside every edge line of a convex outline, within `slack`.
fun inside(shape: Polygon, point: Vec2, slack: Float) -> Bool {
    let count: Int = len(shape.vertices);
    mut winding: Float = 1.0;
    if (signed_area(shape) < 0.0) {
        winding = -1.0;
    }
    for i: Int in 0..count {
        let from: Vec2 = shape.vertices[i];
        let edge: Vec2 = subtract(shape.vertices[(i + 1) % count], from);
        let depth: Float = winding * cross(edge, subtract(point, from)) / sqrt(dot(edge, edge));
        if (depth < -slack) {
            return false;
        }
    }
    return true;
}

mut splits: Int = 0;
mut misses: Int = 0;
mut invalids: Int = 0;
for trial: Int in 0..1500 {
    let cx: Float = (random() - 0.5) * 2000.0;
    let cy: Float = (random() - 0.5) * 2000.0;
    let shape: Polygon = random_convex(cx, cy);
    let start: Vec2 = Vec2(cx + (random() - 0.5) * 16.0, cy + (random() - 0.5) * 16.0);
    let end: Vec2 = Vec2(cx + (random() - 0.5) * 16.0, cy + (random() - 0.5) * 16.0);
    let result: SliceResult = split_convex(shape, start, end, EPSILON);
    if (result.status == "split") {
        splits += 1;
        let original: Float = signed_area(shape);
        let left: Float = signed_area(result.pieces[0]);
        let right: Float = signed_area(result.pieces[1]);
        let difference: Float = left + right - original;
        let tolerance: Float = 0.000000001 * abs(original);
        expect(difference < tolerance and difference > -tolerance, "fuzz area conserved");
        expect(left * original > 0.0 and right * original > 0.0, "fuzz winding kept");
        let blade: Vec2 = subtract(end, start);
        let blade_length: Float = sqrt(dot(blade, blade));
        for vertex: Vec2 in result.pieces[0].vertices {
            expect(inside(shape, vertex, 0.0000001), "left vertex inside parent");
            expect(cross(blade, subtract(vertex, start)) / blade_length > -EPSILON, "left vertex left of blade");
        }
        for vertex: Vec2 in result.pieces[1].vertices {
            expect(inside(shape, vertex, 0.0000001), "right vertex inside parent");
            expect(cross(blade, subtract(vertex, start)) / blade_length < EPSILON, "right vertex right of blade");
        }
        let again: SliceResult = split_convex(result.pieces[1], start, end, EPSILON);
        expect(again.status == "miss", "re-cutting a piece on the same blade misses");
    } else if (result.status == "miss") {
        misses += 1;
    } else {
        // Generated outlines are valid unless two vertices crowd within epsilon.
        expect(result.status == "invalid", "fuzz status is known");
        invalids += 1;
    }
}
expect(splits > 300 and misses > 300, "fuzz exercises both outcomes");
expect(invalids < 15, "generated outlines are almost always valid");
print("PASS: fuzz " + str(splits) + " splits, " + str(misses) + " misses, " + str(invalids) + " invalid");
