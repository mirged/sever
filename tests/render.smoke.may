import "ui" as ui;
import "../src/core/types.may";
import "../src/game/training.may";
import "../src/render/projection.may";
import "../src/render/canvas.may" as canvas;

fun expect_render(value: Bool, label: Str) -> Nil {
    if (not value) { fail("FAIL: " + label); }
    return;
}

let window: ui.Window = ui.open("sever render checks", 1280, 800, true);
may {
    let training: Training = create_training();
    canvas.draw_scene(window, training, false);
    let camera: Camera = room_camera(1280, 800);
    let player: Vec2 = to_screen(camera, training.player.position);
    expect_render(ui.pixel(window, int(player.x), int(player.y)) == 14090061,
        "player is visible in the world camera");
    expect_render(ui.pixel(window, 5, 5) == 1053975, "background palette");
    let original: Int = ui.pixel(window, 400, 320);
    let outside: Int = ui.pixel(window, 240, 310);
    let empty: Int = ui.pixel(window, 300, 460);
    let triangle: List<Vec2> = [Vec2(200.0, 300.0), Vec2(420.0, 300.0), Vec2(420.0, 500.0)];
    canvas.paint_polygon(camera, triangle, 16711680, 16711680);
    let interior: Int = ui.pixel(window, 400, 320);
    expect_render(interior != original, "fill convex triangle interior");
    expect_render(ui.pixel(window, 300, 460) == empty, "do not fill outside triangle");
    expect_render(ui.pixel(window, 240, 310) == outside, "clip polygon away from sidebar");
    canvas.paint_polygon(camera, [triangle[2], triangle[1], triangle[0]], 65280, 65280);
    expect_render(ui.pixel(window, 400, 320) != interior, "render reversed winding");
    expect_render(triangle[0].x == 200.0, "rendering does not mutate vertices");
    ui.close(window);
} otherwise {
    ui.close(window);
    fail(err.message);
}
print("PASS: 7 native rendering checks");
